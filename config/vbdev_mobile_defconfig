# VBdev OS Mobile Configuration
# Dioptimalkan untuk perangkat mobile

# Basic
CONFIG_MOBILE=y
CONFIG_EMBEDDED=y
CONFIG_SMALL=y
CONFIG_VBDEV=y

# Processor
CONFIG_ARM64=y
CONFIG_CPU_LITTLE=y
CONFIG_SCHED_MC=y
CONFIG_NR_CPUS=4

# Memory
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_KSM=y

# Power Management
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_IDLE=y
CONFIG_THERMAL=y

# Touch & Display
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_ATMEL_MXT=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# Audio
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y

# Network
CONFIG_NET=y
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_BLUETOOTH=y
CONFIG_RFKILL=y

# Storage
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y

# USB
CONFIG_USB=y
CONFIG_USB_GADGET=y

# Sensors
CONFIG_IIO=y
CONFIG_SENSORS=y
CONFIG_ACCELEROMETER=y
CONFIG_GYROSCOPE=y

# GPU
CONFIG_DRM=y
CONFIG_DRM_PANEL=y

# Debugging (disable for release)
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_PRINTK_TIME is not set

# Security
CONFIG_SECURITY=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
